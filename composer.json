{
    "name": "ghijk/statamic-country-fieldtype",
    "description": "Country dropdown with ISO 3166 options values",
    "authors": [
        {
            "name": "Alexis Serneels"
        }
    ],
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "symfony/intl": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Ghijk\\CountryFieldtype\\": "src"
        }
    },
    "extra": {
